<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgentFT Report: {{ metadata.name }}</title>
    <style>
        :root {
            --bg: #f2f4f8;
            --card: #ffffff;
            --ink: #1a2233;
            --muted: #53607a;
            --accent: #1b4f72;
            --good: #1f8b4c;
            --bad: #c23a2b;
            --line: #dce2ed;
        }
        body {
            margin: 0;
            font-family: "Avenir Next", "Segoe UI", sans-serif;
            background: radial-gradient(circle at top right, #e6eef8 0%, var(--bg) 45%);
            color: var(--ink);
        }
        .wrap {
            max-width: 1280px;
            margin: 0 auto;
            padding: 24px;
        }
        .panel {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(26, 34, 51, 0.07);
            padding: 18px;
            margin-bottom: 18px;
        }
        .title {
            margin: 0 0 8px 0;
            font-size: 1.6rem;
            letter-spacing: 0.2px;
        }
        .muted {
            color: var(--muted);
            font-family: ui-monospace, Menlo, Monaco, monospace;
            font-size: 0.9rem;
        }
        .stats {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        }
        .stat {
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 12px;
            background: linear-gradient(180deg, #fff, #f9fbff);
        }
        .stat .k {
            font-size: 0.82rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .stat .v {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 4px;
        }
        .good { color: var(--good); }
        .bad { color: var(--bad); }
        .controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 10px;
            align-items: end;
        }
        .controls label {
            font-size: 0.78rem;
            color: var(--muted);
            display: block;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .controls input,
        .controls select {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 0.9rem;
            box-sizing: border-box;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.92rem;
        }
        thead th {
            text-align: left;
            color: #fff;
            background: var(--accent);
            padding: 10px 8px;
            position: sticky;
            top: 0;
        }
        tbody td {
            border-bottom: 1px solid var(--line);
            padding: 9px 8px;
            vertical-align: top;
        }
        tbody tr:hover {
            background: #f8fbff;
        }
        .hidden {
            display: none;
        }
        .details {
            margin-top: 4px;
            color: var(--muted);
            white-space: pre-wrap;
            font-family: ui-monospace, Menlo, Monaco, monospace;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="wrap">
        <section class="panel">
            <h1 class="title">AgentFT Report</h1>
            <div class="muted">Run: {{ metadata.name }} ({{ metadata.run_id }})</div>
            <div class="muted">Schema: {{ metadata.artifact_schema_version }} | Status: {{ metadata.status }}</div>
        </section>

        <section class="panel stats">
            <div class="stat"><div class="k">Total</div><div class="v">{{ summary.total }}</div></div>
            <div class="stat"><div class="k">Passed</div><div class="v good">{{ summary.passed }}</div></div>
            <div class="stat"><div class="k">Failed</div><div class="v bad">{{ summary.total - summary.passed }}</div></div>
            <div class="stat">
                <div class="k">Pass Rate</div>
                <div class="v {% if summary.pass_rate >= 0.8 %}good{% else %}bad{% endif %}">
                    {{ "%.1f"|format(summary.pass_rate * 100) }}%
                </div>
            </div>
            <div class="stat"><div class="k">Cost USD</div><div class="v">{{ "%.6f"|format(summary.total_cost_usd or 0.0) }}</div></div>
            <div class="stat"><div class="k">Avg Latency</div><div class="v">{{ "%.2f"|format(summary.avg_latency_ms or 0.0) }} ms</div></div>
        </section>

        <section class="panel">
            <h2 class="title" style="font-size:1.1rem">Filters</h2>
            <div class="controls">
                <div>
                    <label for="f-agent">Agent</label>
                    <select id="f-agent">
                        <option value="">All</option>
                        {% for agent, _ in summary.per_agent.items() %}
                        <option value="{{ agent }}">{{ agent }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="f-scenario">Scenario</label>
                    <select id="f-scenario">
                        <option value="">All</option>
                        {% for scenario, _ in summary.per_scenario.items() %}
                        <option value="{{ scenario }}">{{ scenario }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="f-status">Status</label>
                    <select id="f-status">
                        <option value="">All</option>
                        <option value="pass">Pass</option>
                        <option value="fail">Fail</option>
                    </select>
                </div>
                <div>
                    <label for="f-query">Search Task/Error</label>
                    <input id="f-query" type="text" placeholder="task id or error text" />
                </div>
            </div>
        </section>

        <section class="panel">
            <h2 class="title" style="font-size:1.1rem">Per Agent Performance</h2>
            <table>
                <thead>
                    <tr>
                        <th>Agent</th>
                        <th>Total</th>
                        <th>Passed</th>
                        <th>Failed</th>
                        <th>Pass Rate</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent, stats in summary.per_agent.items() %}
                    <tr>
                        <td>{{ agent }}</td>
                        <td>{{ stats.total }}</td>
                        <td class="good">{{ stats.passed }}</td>
                        <td class="bad">{{ stats.total - stats.passed }}</td>
                        <td>{{ "%.1f"|format((stats.passed / stats.total * 100) if stats.total > 0 else 0) }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="panel">
            <h2 class="title" style="font-size:1.1rem">Result Drilldown</h2>
            <table id="results-table">
                <thead>
                    <tr>
                        <th>Scenario</th>
                        <th>Task</th>
                        <th>Agent</th>
                        <th>Judge</th>
                        <th>Status</th>
                        <th>Latency (ms)</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    {% for result in results %}
                    <tr
                        data-agent="{{ result.agent }}"
                        data-scenario="{{ result.scenario }}"
                        data-status="{% if result.passed %}pass{% else %}fail{% endif %}"
                        data-search="{{ result.task_id }} {{ result.error or '' }}"
                    >
                        <td>{{ result.scenario }}</td>
                        <td>{{ result.task_id }}</td>
                        <td>{{ result.agent }}</td>
                        <td>{{ result.judge }}</td>
                        <td class="{% if result.passed %}good{% else %}bad{% endif %}">
                            {% if result.passed %}PASS{% else %}FAIL{% endif %}
                        </td>
                        <td>{{ "%.2f"|format(result.latency_ms or 0.0) }}</td>
                        <td>
                            {% if result.error %}
                            <div class="bad">{{ result.error }}</div>
                            {% if result.error_type %}
                            <div class="details">{{ result.error_type }}</div>
                            {% endif %}
                            {% else %}
                            <span class="muted">-</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
    <script>
        (function () {
            const rows = Array.from(document.querySelectorAll("#results-table tbody tr"));
            const fAgent = document.getElementById("f-agent");
            const fScenario = document.getElementById("f-scenario");
            const fStatus = document.getElementById("f-status");
            const fQuery = document.getElementById("f-query");

            function applyFilters() {
                const a = (fAgent.value || "").toLowerCase();
                const s = (fScenario.value || "").toLowerCase();
                const st = (fStatus.value || "").toLowerCase();
                const q = (fQuery.value || "").toLowerCase().trim();

                for (const row of rows) {
                    const okAgent = !a || (row.dataset.agent || "").toLowerCase() === a;
                    const okScenario = !s || (row.dataset.scenario || "").toLowerCase() === s;
                    const okStatus = !st || (row.dataset.status || "").toLowerCase() === st;
                    const okQuery = !q || (row.dataset.search || "").toLowerCase().includes(q);
                    row.classList.toggle("hidden", !(okAgent && okScenario && okStatus && okQuery));
                }
            }

            [fAgent, fScenario, fStatus].forEach((el) => el.addEventListener("change", applyFilters));
            fQuery.addEventListener("input", applyFilters);
        })();
    </script>
</body>
</html>
